# ─── Shopify ──────────────────────────────────────────────────────────────────
# Your store's .myshopify.com domain (no https://, no trailing slash)
# Example: my-cool-store.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Admin API access token from a Custom App (not a private app).
# Create one at: Shopify Admin → Settings → Apps → Develop apps
# Required scopes: read_products, read_inventory
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify API version — use a recent stable release.
# Check: https://shopify.dev/docs/api/usage/versioning
SHOPIFY_API_VERSION=2025-01

# ─── Inventory ────────────────────────────────────────────────────────────────
# Variants with quantity below this number are flagged as "low stock".
# Variants at exactly 0 get an immediate alert email regardless of this value.
LOW_STOCK_THRESHOLD=10

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Your Gmail address used to send alerts.
GMAIL_USER=you@gmail.com

# An App Password — NOT your normal Gmail password.
# Gmail requires App Passwords when 2FA is enabled (which it should be).
# Generate one at: https://myaccount.google.com/apppasswords
# Select "Mail" + "Other (custom name)" → copy the 16-character code here.
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Recipient address for all alert emails.
# Use a comma-separated list to notify multiple people:
# ALERT_EMAIL_TO=ops@yourcompany.com,ceo@yourcompany.com
ALERT_EMAIL_TO=alerts@yourcompany.com

# ─── Scheduling ───────────────────────────────────────────────────────────────
# Timezone for the 8 AM cron job. Must be a valid IANA timezone name.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York | America/Chicago | America/Los_Angeles | Europe/London | UTC
CRON_TIMEZONE=America/New_York
